# Shared Ghostty settings for every machine.
# Each machine's ~/.config/ghostty/config.ghostty loads this file, then
# linux.ghostty or macos.ghostty. scripts/setup-ghostty writes that file.

theme = Moonfly
background = #000000

# Use Ghostty's platform default font. Keeping this unset avoids requiring a
# separately installed font on each machine.

# Let these reach Neovim to switch terminal panels instead of Ghostty tabs
keybind = ctrl+page_up=unbind
keybind = ctrl+page_down=unbind
